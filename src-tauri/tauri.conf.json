{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reality Workshop",
  "version": "1.0.0",
  "identifier": "studio.realityworkshop.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1547",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Reality Workshop",
        "width": 1480,
        "height": 940,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#171b1d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost http://localhost:1547 ws://localhost:1547; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "workers/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
